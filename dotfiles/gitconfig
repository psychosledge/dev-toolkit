[user]
	name = Bo Ramsey
[alias]
	lg = !git log --graph --decorate --all -n 20 && git status
	lgs = !git log --graph --decorate -n 20 $@ && git status
	lga = log --graph --decorate --all
	ec = config --global -e
	co = !git checkout $@ && git branch && git status
	up = !git pull --rebase --autostash --prune $@ && git submodule update --init --recursive
	cob = checkout -b
	cm = commit -m
	cma = !git add -A && git commit -m
	cmf = commit --no-verify -m
	undo = reset HEAD~1 --mixed
	amend = commit --amend
	wipe = !git add -A && git commit -qm 'WIPE SAVEPOINT' && git reset HEAD~1 --hard
	nm = branch --no-merged
	pf = push --force-with-lease
	pub = !git push --set-upstream origin $(git symbolic-ref --short HEAD)
	ab = branch -a
	feta = fetch --all --prune
	b = branch
	rd = push -d origin
	rbi = "!f() { git fetch origin && git rebase -i \"${1:-$(git merge-base HEAD origin/HEAD)}\"; }; f"
	rbo = "!git fetch --prune origin && b=$(git symbolic-ref --short HEAD) && if up=$(git rev-parse --abbrev-ref --symbolic-full-name \"$b@{u}\" 2>/dev/null); then behind=$(git rev-list --count \"$b..$up\") && if [ \"$behind\" = \"0\" ]; then git rebase --autostash origin/HEAD; else echo 'You have commits to pull from '\"$up\"; fi; else git rebase --autostash origin/HEAD; fi"
	dpb = branch -D @{-1}
[format]
	#example: xxxxxxxx  30 minutes ago  Bo Ramsey  (HEAD -> master, origin/master, origin/HEAD)  did some stuff
	pretty = format:%C(auto,yellow)%h  %C(auto,cyan)%as  %C(auto,green)%aN%C(auto)% gd% d  %C(auto,reset)%s
[core]
	editor = code --wait
	pager = "command -v hunk >/dev/null 2>&1 && hunk pager || { echo 'hunk not found -- install with: npm install -g hunkdiff' >&2; less; }"
[url "git@github.com:"]
	insteadOf = https://github.com/
