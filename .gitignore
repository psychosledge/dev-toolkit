# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Editor/IDE settings (personal; don't copy into projects)
.vscode/
.idea/
*.swp
*~

# Local env files / secrets (keep out of git)
.env
.env.*
!.env.example

# Local tooling caches
*.log
.cache/
.tmp/
tmp/

# Node/JS (in case commands/scripts use node locally)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/

# Python (in case you add scripts later)
.venv/
venv/
__pycache__/
.pytest_cache/

# Terraform (if you ever add infra snippets)
.terraform/
.terraform.lock.hcl